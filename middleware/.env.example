# ─── Wheelson Connection ─────────────────────────────────────────────────────
# IP address of the Wheelson on your local network.
# Open the Serial Monitor after flashing to find it.
WHEELSON_IP=192.168.1.100

# ─── Gemini API ───────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Explorer Loop ───────────────────────────────────────────────────────────
# Local control tick, independent of model latency (clamped to 0.05–0.2 s).
LOOP_INTERVAL_SEC=0.1
CAMERA_INTERVAL_SEC=0.15
PERCEPTION_MAX_AGE_SEC=0.8
# Visual color-based obstacle gate; tune on your floor before free exploration.
FIRMWARE_VISUAL_SAFETY=True

# ─── Middleware Server ────────────────────────────────────────────────────────
# Port for the FastAPI dashboard (http://localhost:PORT)
PORT=8000
